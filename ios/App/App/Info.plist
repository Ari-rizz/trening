<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>IronGrid</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>IronGrid trenger tilgang til Apple Health for å synkronisere treningsøkter og kroppsvekt mellom appen og Apple Health.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>IronGrid trenger tillatelse til å skrive treningsøkter og kroppsvekt tilbake til Apple Health slik at dataene dine holdes oppdatert på tvers av enheter.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>IronGrid sender push-varsler for hviletids-timer, vektpåminnelser og øktpåminnelser. Du kan slå av varsler når som helst i profil-fanen.</string>
	<key>NSUserTrackingUsageDescription</key>
	<string>IronGrid sporer ikke din aktivitet på tvers av andre selskapers apper eller nettsteder.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>IronGrid trenger tilgang til kameraet for å la deg ta profilbilde.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>IronGrid trenger tilgang til bildebiblioteket for å la deg velge et profilbilde fra dine bilder.</string>
</dict>
</plist>
